@model List<SIMS.Models.Course>
@{
    ViewData["Title"] = "Courses";
    Layout = "_Layout";
    var enrolledIds = ViewBag.EnrolledIds as List<int>;
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
<div class="mb-4">
    <h2><i class="bi bi-journal-bookmark"></i> Course Enrolment</h2>
    <p class="text-muted">Courses in your programme</p>
</div>
<div class="card">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead><tr><th>Code</th><th>Name</th><th>Credits</th><th>Action</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CourseCode</td>
                        <td>@c.CourseName</td>
                        <td>@c.Credits</td>
                        <td>
                            @if (enrolledIds != null && enrolledIds.Contains(c.CourseID))
                            {
                                <a href="/Student/Drop/@c.CourseID" class="btn btn-sm btn-outline-danger">Drop</a>
                            }
                            else
                            {
                                <a href="/Student/Enrol/@c.CourseID" class="btn btn-sm btn-success">Enrol</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>