@model List<SIMS.Models.User>
@{
    ViewData["Title"] = "Manage Users";
    Layout = "_Layout";
}

<div class="mb-4">
    <h2><i class="bi bi-people"></i> Manage Users</h2>
    <p class="text-muted">All system users and their roles</p>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Username</td>
                        <td>@u.Email</td>
                        <td>
                            @if (u.Role == "Admin")
                            {
                                <span class="badge bg-danger">@u.Role</span>
                            }
                            else if (u.Role == "Lecturer")
                            {
                                <span class="badge bg-primary">@u.Role</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@u.Role</span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Disabled</span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <a href="/Users/ToggleActive/@u.UserID" class="btn btn-sm btn-outline-warning">Disable</a>
                            }
                            else
                            {
                                <a href="/Users/ToggleActive/@u.UserID" class="btn btn-sm btn-outline-success">Enable</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>