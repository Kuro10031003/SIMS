@model SIMS.Models.Programme
@{
    ViewData["Title"] = "Add Programme";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body p-4">
                <h3 class="mb-4"><i class="bi bi-plus-circle"></i> Add Programme</h3>

                <form method="post" asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label">Programme Code</label>
                        <input name="ProgrammeCode" class="form-control" required placeholder="e.g. BCS" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Programme Name</label>
                        <input name="ProgrammeName" class="form-control" required placeholder="e.g. BSc Computer Science" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Duration (Years)</label>
                        <input name="DurationYears" type="number" class="form-control" required min="1" max="6" />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save</button>
                    <a href="/Programmes/Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>