@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--surface-soft);">
    <div style="width:100%; max-width:420px; padding:24px;">

        <div style="text-align:center; margin-bottom:32px;">
            <i class="bi bi-mortarboard-fill" style="font-size:48px; color:var(--primary);"></i>
            <h1 style="font-size:32px; font-weight:600; letter-spacing:-0.5px; margin-top:12px;">SIMS</h1>
            <p class="text-muted" style="margin:0;">Student Information Management System</p>
        </div>

        <div class="card">
            <div class="card-body" style="padding:32px;">
                <h2 style="font-size:22px; margin-bottom:24px;">Sign in</h2>

                @if (ViewBag.Error != null)
                {
                    <div style="background:#fdecec; border:1px solid #f5c2c7; color:var(--down); border-radius:12px; padding:12px 16px; margin-bottom:20px; font-size:14px;">
                        <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
                    </div>
                }

                <form method="post" asp-action="Login">
                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input type="text" name="username" class="form-control" required autofocus />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Password</label>
                        <input type="password" name="password" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100" style="height:48px;">Sign in</button>
                </form>
            </div>
        </div>

    </div>
</div>