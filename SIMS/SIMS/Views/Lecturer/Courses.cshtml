@model List<SIMS.Models.Course>
@{
    ViewData["Title"] = "My Courses";
    Layout = "_Layout";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success"><i class="bi bi-check-circle"></i> @TempData["Message"]</div>
}

<div class="mb-4">
    <h2><i class="bi bi-journal-bookmark"></i> My Courses</h2>
    <p class="text-muted">Courses you are teaching</p>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Credits</th>
                    <th>Semester</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted">You are not assigned to any courses yet.</td></tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.CourseCode</td>
                            <td>@c.CourseName</td>
                            <td>@c.Credits</td>
                            <td>@c.Semester</td>
                            <td>
                                <a href="/Lecturer/CourseStudents/@c.CourseID" class="btn btn-sm btn-outline-primary">View Students</a>
                                <a href="/Lecturer/TakeAttendance/@c.CourseID" class="btn btn-sm btn-outline-success">Take Attendance</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>