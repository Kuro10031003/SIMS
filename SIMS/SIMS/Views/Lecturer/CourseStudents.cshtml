@model List<SIMS.Models.Student>
@{
    ViewData["Title"] = "Course Students";
    Layout = "_Layout";
}

<div class="mb-4">
    <h2><i class="bi bi-people"></i> Students in @ViewBag.CourseCode</h2>
    <p class="text-muted">@ViewBag.CourseName</p>
    <a href="/Lecturer/Courses" class="btn btn-sm btn-secondary"><i class="bi bi-arrow-left"></i> Back to My Courses</a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Student ID</th>
                    <th>Full Name</th>
                    <th>Phone</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted">No students enrolled in this course yet.</td></tr>
                }
                else
                {
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.StudentID</td>
                            <td>@s.FullName</td>
                            <td>@s.Phone</td>
                            <td><span class="badge bg-success">@s.Status</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>