@model SIMS.Models.Course
@{
    ViewData["Title"] = "Delete Course";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-body p-4">
                <h3 class="mb-3 text-danger"><i class="bi bi-exclamation-triangle"></i> Delete Course</h3>
                <p>Are you sure you want to delete this course?</p>
                <table class="table">
                    <tr><th>Code</th><td>@Model.CourseCode</td></tr>
                    <tr><th>Name</th><td>@Model.CourseName</td></tr>
                    <tr><th>Credits</th><td>@Model.Credits</td></tr>
                </table>
                <form method="post" asp-action="Delete">
                    <input type="hidden" name="id" value="@Model.CourseID" />
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, Delete</button>
                    <a href="/Courses/Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>