@model SIMS.Models.Course
@{
    ViewData["Title"] = "Edit Course";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body p-4">
                <h3 class="mb-4"><i class="bi bi-pencil-square"></i> Edit Course</h3>
                <form method="post" asp-action="Edit">
                    <input type="hidden" name="CourseID" value="@Model.CourseID" />
                    <div class="mb-3">
                        <label class="form-label">Course Code</label>
                        <input name="CourseCode" class="form-control" required value="@Model.CourseCode" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Course Name</label>
                        <input name="CourseName" class="form-control" required value="@Model.CourseName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Credits</label>
                        <input name="Credits" type="number" class="form-control" required min="1" max="10" value="@Model.Credits" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Programme</label>
                        <select name="ProgrammeID" class="form-select" asp-items="ViewBag.Programmes" required></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lecturer</label>
                        <select name="LecturerID" class="form-select" asp-items="ViewBag.Lecturers">
                            <option value="">-- Select Lecturer (optional) --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Semester</label>
                        <input name="Semester" class="form-control" value="@Model.Semester" />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Update</button>
                    <a href="/Courses/Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>