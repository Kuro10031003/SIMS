@model List<SIMS.Models.Course>
@{
    ViewData["Title"] = "Manage Courses";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-journal-bookmark"></i> Manage Courses</h2>
    <a href="/Courses/Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add Course</a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Credits</th>
                    <th>Semester</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted">No courses yet.</td></tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.CourseCode</td>
                            <td>@c.CourseName</td>
                            <td>@c.Credits</td>
                            <td>@c.Semester</td>
                            <td>
                                <a href="/Courses/Edit/@c.CourseID" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a href="/Courses/Delete/@c.CourseID" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>