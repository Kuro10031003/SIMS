@model SIMS.Models.Course
@{
    ViewData["Title"] = "Add Course";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body p-4">
                <h3 class="mb-4"><i class="bi bi-plus-circle"></i> Add Course</h3>
                <form method="post" asp-action="Create">
                    <div class="mb-3">
                        <label class="form-label">Course Code</label>
                        <input name="CourseCode" class="form-control" required placeholder="e.g. CS103" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Course Name</label>
                        <input name="CourseName" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Credits</label>
                        <input name="Credits" type="number" class="form-control" required min="1" max="10" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Programme</label>
                        <select name="ProgrammeID" class="form-select" asp-items="ViewBag.Programmes" required>
                            <option value="">-- Select Programme --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Lecturer</label>
                        <select name="LecturerID" class="form-select" asp-items="ViewBag.Lecturers">
                            <option value="">-- Select Lecturer (optional) --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Semester</label>
                        <input name="Semester" class="form-control" placeholder="e.g. 2026-1" />
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save</button>
                    <a href="/Courses/Index" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>